generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

model User {
  id                      String                  @id @default(cuid())
  email                   String                  @unique
  passwordHash            String
  name                    String
  phone                   String?
  role                    String
  isActive                Boolean                 @default(true)
  emailVerified           Boolean                 @default(false)
  fcmToken                String?
  verificationStatus      String                  @default("pending") @map("verification_status") // "pending", "submitted", "approved", "rejected"
  verificationDeadline    DateTime?               @map("verification_deadline") // 14-day limit
  legalDocuments          String?                 @map("legal_documents") // JSON list of document paths
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt
  appointmentsAsDoctor    Appointment[]           @relation("DoctorAppointments")
  appointmentsAsPatient   Appointment[]           @relation("PatientAppointments")
  auditLogs               AuditLog[]
  deliveryDriverProfile   DeliveryDriverProfile?
  deliveryOrdersAsPatient DeliveryOrder[]         @relation("PatientDeliveries")
  deliveryOrdersAsDriver  DeliveryOrder[]         @relation("DriverDeliveries")
  doctorProfile           DoctorProfile?
  patientProfile          PatientProfile?
  pharmacyManagerProfile  PharmacyManagerProfile?
  prescriptionsAsDoctor   Prescription[]          @relation("DoctorPrescriptions")
  prescriptionsAsPatient  Prescription[]          @relation("PatientPrescriptions")
  receptionistProfile     ReceptionistProfile?
  refreshTokens           RefreshToken[]
  salesAsPatient          Sale[]                  @relation("PatientSales")
  chatParticipants        ChatParticipant[]
  chatMessages            ChatMessage[]
  reviews                 Review[]
  caregiverRelations      FamilyRelationship[]    @relation("CaregiverRelations")
  patientRelations        FamilyRelationship[]    @relation("PatientRelations")
  sentInvitations         Invitation[]            @relation("SentInvitations")
  betaFeedbacks           BetaFeedback[]
  pushTokens              PushToken[]
  doctorDocumentsUploaded DoctorDocument[]        @relation("DoctorDocumentUploader")
  doctorDocumentsVerified DoctorDocument[]        @relation("DoctorDocumentVerifier")
  clinicDocumentsUploaded ClinicDocument[]        @relation("ClinicDocumentUploader")
  clinicDocumentsVerified ClinicDocument[]        @relation("ClinicDocumentVerifier")
  pharmacyDocumentsUploaded PharmacyDocument[]    @relation("PharmacyDocumentUploader")
  pharmacyDocumentsVerified PharmacyDocument[]    @relation("PharmacyDocumentVerifier")
  notifications             Notification[]        @relation("UserNotifications")
  settings                  UserSettings?

  @@index([email])
  @@index([role])
  @@index([isActive])
  @@map("users")
}

model PatientProfile {
  userId       String   @id @map("user_id")
  dateOfBirth  String?
  bloodType    String?
  allergies    String?
  medicalNotes String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("patient_profiles")
}

model DoctorProfile {
  userId        String   @id @map("user_id")
  clinicId      String   @map("clinic_id")
  specialty     String   @default("Medicina General")
  licenseNumber String   @unique
  signaturePin  String?  @map("signature_pin")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  clinic        Clinic   @relation(fields: [clinicId], references: [id])
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  specialties   DoctorProfileSpecialty[]

  @@index([clinicId])
  @@map("doctor_profiles")
}

model PharmacyManagerProfile {
  userId     String    @id @map("user_id")
  pharmacyId String?   @map("pharmacy_id")
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  pharmacy   Pharmacy? @relation(fields: [pharmacyId], references: [id])
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("pharmacy_manager_profiles")
}

model DeliveryDriverProfile {
  userId         String   @id @map("user_id")
  pharmacyId     String   @map("pharmacy_id")
  vehicleType    String   @default("motocicleta")
  licensePlate   String?
  isAvailable    Boolean  @default(true)
  currentLat     Float?
  currentLng     Float?
  employmentType String   @default("contractor") @map("employment_type")
  baseSalary     Float?   @map("base_salary")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  pharmacy       Pharmacy @relation(fields: [pharmacyId], references: [id])
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([pharmacyId])
  @@map("delivery_driver_profiles")
}

model ReceptionistProfile {
  userId    String   @id @map("user_id")
  clinicId  String?  @map("clinic_id")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  clinic    Clinic?  @relation(fields: [clinicId], references: [id])
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([clinicId])
  @@map("receptionist_profiles")
}

model Clinic {
  id                   String                @id @default(cuid())
  name                 String
  address              String
  latitude             Float                 @default(19.4326)
  longitude            Float                 @default(-99.1332)
  phone                String?
  isActive             Boolean               @default(true)
  ownerId              String?               @map("owner_id")
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  appointments         Appointment[]
  doctorProfiles       DoctorProfile[]
  prescriptions        Prescription[]
  receptionistProfiles ReceptionistProfile[]
  sales                Sale[]
  invitations          Invitation[]
  clinicDocuments      ClinicDocument[]
  settings             ClinicSettings?

  @@index([isActive])
  @@map("clinics")
}

model Pharmacy {
  id                      String                   @id @default(cuid())
  name                    String
  address                 String
  latitude                Float                    @default(19.4326)
  longitude               Float                    @default(-99.1332)
  phone                   String?
  isActive                Boolean                  @default(true)
  deliveryFee             Float                    @default(29.90)
  ownerId                 String?                  @map("owner_id")
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  deliveryOrders          DeliveryOrder[]
  inventory               Inventory[]
  pharmacyManagerProfiles PharmacyManagerProfile[]
  deliveryDriverProfiles  DeliveryDriverProfile[]
  fulfilledPrescriptions  Prescription[]           @relation("FulfilledPharmacy")
  sales                   Sale[]
  invitations             Invitation[]
  pharmacyDocuments       PharmacyDocument[]
  settings                PharmacySettings?

  @@index([isActive])
  @@map("pharmacies")
}

model Medicine {
  id                   String             @id @default(cuid())
  name                 String
  genericName          String?
  description          String?
  dosageForm           String?
  concentration        String?
  requiresPrescription Boolean            @default(true)
  isActive             Boolean            @default(true)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  inventory            Inventory[]
  prescriptionLines    PrescriptionLine[]
  saleItems            SaleItem[]

  @@index([name])
  @@index([genericName])
  @@map("medicines")
}

model Inventory {
  id             String   @id @default(cuid())
  pharmacyId     String
  medicineId     String
  quantity       Int      @default(0) // Total quantity (aggregated from batches)
  minStock       Int      @default(10)
  unitPrice      Float    @default(0) // Default/Last price
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  medicine       Medicine @relation(fields: [medicineId], references: [id], onDelete: Cascade)
  pharmacy       Pharmacy @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  movements      InventoryMovement[]
  batches        InventoryBatch[]

  @@unique([pharmacyId, medicineId])
  @@index([pharmacyId])
  @@index([medicineId])
  @@map("inventory")
}

model InventoryBatch {
  id             String    @id @default(cuid())
  inventoryId    String
  batchNumber    String
  quantity       Int
  costPrice      Float?    @map("cost_price")
  sellingPrice   Float?    @map("selling_price")
  expirationDate DateTime? @map("expiration_date")
  supplier       String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  inventory      Inventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)

  @@index([inventoryId])
  @@index([expirationDate])
  @@map("inventory_batches")
}

model Appointment {
  id                 String         @id @default(cuid())
  patientId          String
  doctorId           String
  clinicId           String
  dateTime           DateTime
  durationMinutes    Int            @default(30)
  status             String         @default("scheduled")
  cancellationReason String?
  notes              String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  clinic             Clinic         @relation(fields: [clinicId], references: [id])
  doctor             User           @relation("DoctorAppointments", fields: [doctorId], references: [id])
  patient            User           @relation("PatientAppointments", fields: [patientId], references: [id])
  prescriptions      Prescription[]
  sale               Sale?

  @@index([patientId])
  @@index([doctorId])
  @@index([clinicId])
  @@index([dateTime])
  @@index([status])
  @@map("appointments")
}

model Prescription {
  id                  String             @id @default(cuid())
  patientId           String
  doctorId            String
  clinicId            String
  appointmentId       String?
  status              String             @default("active")
  qrCode              String?            @unique
  verificationCode    String?            @unique @map("verification_code")
  digitalSignature    String?            @map("digital_signature")
  notes               String?
  issuedAt            DateTime           @default(now())
  expirationDate      String
  fulfilledAt         DateTime?
  fulfilledPharmacyId String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  prescriptionLines   PrescriptionLine[]
  fulfilledPharmacy   Pharmacy?          @relation("FulfilledPharmacy", fields: [fulfilledPharmacyId], references: [id])
  appointment         Appointment?       @relation(fields: [appointmentId], references: [id])
  clinic              Clinic             @relation(fields: [clinicId], references: [id])
  doctor              User               @relation("DoctorPrescriptions", fields: [doctorId], references: [id])
  patient             User               @relation("PatientPrescriptions", fields: [patientId], references: [id])
  sales               Sale[]

  @@index([patientId])
  @@index([doctorId])
  @@index([status])
  @@index([qrCode])
  @@index([appointmentId])
  @@map("prescriptions")
}

model PrescriptionLine {
  id                 String       @id @default(cuid())
  prescriptionId     String
  medicineId         String
  quantity           Int
  dosageInstructions String
  quantityFulfilled  Int          @default(0)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  medicine           Medicine     @relation(fields: [medicineId], references: [id])
  prescription       Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)

  @@index([prescriptionId])
  @@index([medicineId])
  @@map("prescription_lines")
}

model Sale {
  id              String         @id @default(cuid())
  pharmacyId      String?
  clinicId        String?
  patientId       String?
  prescriptionId  String?
  appointmentId   String?        @unique
  isDelivery      Boolean        @default(false)
  deliveryAddress String?
  deliveryLat     Float?
  deliveryLng     Float?
  deliveryNotes   String?
  status          String         @default("pending")
  totalAmount     Float          @default(0)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  deliveryOrder   DeliveryOrder?
  saleItems       SaleItem[]
  prescription    Prescription?  @relation(fields: [prescriptionId], references: [id])
  patient         User?          @relation("PatientSales", fields: [patientId], references: [id])
  pharmacy        Pharmacy?      @relation(fields: [pharmacyId], references: [id])
  clinic          Clinic?        @relation(fields: [clinicId], references: [id])
  appointment     Appointment?   @relation(fields: [appointmentId], references: [id])
  payments        Payment[]

  @@index([pharmacyId])
  @@index([clinicId])
  @@index([patientId])
  @@index([status])
  @@map("sales")
}

model SaleItem {
  id         String   @id @default(cuid())
  saleId     String
  medicineId String
  quantity   Int
  unitPrice  Float
  createdAt  DateTime @default(now())
  medicine   Medicine @relation(fields: [medicineId], references: [id])
  sale       Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([saleId])
  @@map("sale_items")
}

model DeliveryOrder {
  id               String          @id @default(cuid())
  saleId           String          @unique
  pharmacyId       String
  deliveryDriverId String?
  patientId        String
  pickupAddress    String
  pickupLat        Float
  pickupLng        Float
  deliveryAddress  String
  deliveryLat      Float
  deliveryLng      Float
  status           String          @default("pending")
  assignedAt       DateTime?
  pickedUpAt       DateTime?
  deliveredAt      DateTime?
  notes            String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  patient          User            @relation("PatientDeliveries", fields: [patientId], references: [id])
  deliveryDriver   User?           @relation("DriverDeliveries", fields: [deliveryDriverId], references: [id])
  pharmacy         Pharmacy        @relation(fields: [pharmacyId], references: [id])
  sale             Sale            @relation(fields: [saleId], references: [id])
  deliveryRoutes   DeliveryRoute[]

  @@index([saleId])
  @@index([pharmacyId])
  @@index([deliveryDriverId])
  @@index([patientId])
  @@index([status])
  @@map("delivery_orders")
}

model DeliveryRoute {
  id              String        @id @default(cuid())
  deliveryOrderId String
  driverLat       Float
  driverLng       Float
  recordedAt      DateTime      @default(now())
  deliveryOrder   DeliveryOrder @relation(fields: [deliveryOrderId], references: [id], onDelete: Cascade)

  @@index([deliveryOrderId])
  @@index([recordedAt])
  @@map("delivery_routes")
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  entityType String
  entityId   String?
  details    String?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())
  user       User?    @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([userId, createdAt])
  @@index([action])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tokenHash])
  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model InventoryMovement {
  id             String   @id @default(cuid())
  inventoryId    String
  userId         String?
  type           String   // "restock", "sale", "adjustment", "in", "out"
  quantityChange Int
  reason         String?
  createdAt      DateTime @default(now())
  inventory      Inventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)

  @@index([inventoryId])
  @@index([inventoryId, createdAt])
  @@map("inventory_movements")
}

model ChatSession {
  id          String        @id @default(cuid())
  type        String        // "doctor_patient", "patient_pharmacy", "patient_delivery", "delivery_pharmacy"
  targetId    String?       // reference to appointmentId, deliveryId, or orderId
  isActive    Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  messages    ChatMessage[]
  participants ChatParticipant[]

  @@map("chat_sessions")
}

model ChatParticipant {
  id        String      @id @default(cuid())
  sessionId String
  userId    String
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([sessionId, userId])
  @@map("chat_participants")
}

model ChatMessage {
  id        String      @id @default(cuid())
  sessionId String
  senderId  String
  content   String
  isRead    Boolean     @default(false)
  createdAt DateTime    @default(now())
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sender    User        @relation(fields: [senderId], references: [id])

  @@map("chat_messages")
}

model Review {
  id         String   @id @default(cuid())
  userId     String
  targetId   String   // id of doctor, medicine, or pharmacy
  targetType String   // "doctor", "medicine", "pharmacy"
  rating     Int      // 1-5
  comment    String?
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id])

  @@map("reviews")
}

model FamilyRelationship {
  id               String    @id @default(cuid())
  caregiverId      String    @map("caregiver_id")
  patientId        String    @map("patient_id")
  relationship     String    // "padre", "madre", "hijo", "conyuge", "tutor", "otro"
  isActive         Boolean   @default(true) @map("is_active")
  status           String    @default("active")  // "pending", "active", "rejected"
  verificationCode String?   @map("verification_code")
  codeExpiresAt    DateTime? @map("code_expires_at")
  permissions      String[]  @default(["view_health_data", "buy_medicines", "schedule_appointments"])
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  caregiver        User      @relation("CaregiverRelations", fields: [caregiverId], references: [id], onDelete: Cascade)
  patient          User      @relation("PatientRelations", fields: [patientId], references: [id], onDelete: Cascade)

  @@unique([caregiverId, patientId])
  @@index([verificationCode])
  @@map("family_relationships")
}

model Payment {
  id            String   @id @default(cuid())
  saleId        String?  @map("sale_id")
  amount        Float
  currency      String   // "NIO", "USD"
  method        String   // "cash", "card", "bank_transfer"
  status        String   // "pending", "completed", "failed", "refunded"
  transactionId String?  @map("transaction_id")
  notes         String?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  sale          Sale?    @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@map("payments")
}

model DoctorSpecialty {
  id          String                   @id @default(cuid())
  name        String                   @unique
  description String?
  createdAt   DateTime                 @default(now()) @map("created_at")
  updatedAt   DateTime                 @updatedAt @map("updated_at")
  doctors     DoctorProfileSpecialty[]

  @@map("doctor_specialties")
}

model DoctorProfileSpecialty {
  doctorId    String          @map("doctor_id")
  specialtyId String          @map("specialty_id")
  createdAt   DateTime        @default(now()) @map("created_at")
  doctor      DoctorProfile   @relation(fields: [doctorId], references: [userId], onDelete: Cascade)
  specialty   DoctorSpecialty @relation(fields: [specialtyId], references: [id], onDelete: Cascade)

  @@id([doctorId, specialtyId])
  @@map("doctor_profile_specialties")
}

model Invitation {
  id          String    @id @default(cuid())
  email       String
  role        String    // "doctor", "receptionist", "cashier", "delivery_driver"
  token       String    @unique
  expiresAt   DateTime  @map("expires_at")
  isAccepted  Boolean   @default(false) @map("is_accepted")
  
  senderId    String    @map("sender_id")
  sender      User      @relation("SentInvitations", fields: [senderId], references: [id], onDelete: Cascade)

  clinicId    String?   @map("clinic_id")
  clinic      Clinic?   @relation(fields: [clinicId], references: [id], onDelete: SetNull)

  pharmacyId  String?   @map("pharmacy_id")
  pharmacy    Pharmacy? @relation(fields: [pharmacyId], references: [id], onDelete: SetNull)

  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([token])
  @@index([email])
  @@map("invitations")
}

model BetaFeedback {
  id        String   @id @default(cuid())
  userId    String?  @map("user_id")
  type      String   // "bug" | "suggestion" | "general"
  content   String
  status    String   @default("pending") // "pending" | "resolved" | "ignored"
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([type])
  @@index([status])
  @@map("beta_feedbacks")
}

model PushToken {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  token      String   @unique
  deviceInfo String?  @map("device_info")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_tokens")
}

model DoctorDocument {
  id              String    @id @default(cuid())
  doctorId        String    @map("doctor_id")
  type            String    // "id_card_front", "id_card_back", "degree", "license", "specialty", "conduct"
  documentUrl     String    @map("document_url")
  expiryDate      DateTime? @map("expiry_date")
  verifiedBy      String?   @map("verified_by")
  verifiedAt      DateTime? @map("verified_at")
  status          String    @default("pending") // pending, approved, rejected
  rejectionReason String?   @map("rejection_reason")
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  doctor          User      @relation("DoctorDocumentUploader", fields: [doctorId], references: [id], onDelete: Cascade)
  verifier        User?     @relation("DoctorDocumentVerifier", fields: [verifiedBy], references: [id])

  @@index([doctorId])
  @@index([status])
  @@map("doctor_documents")
}

model ClinicDocument {
  id              String    @id @default(cuid())
  clinicId        String    @map("clinic_id")
  type            String    // "ruc", "sanitary_permit", "municipal_license", "minsa_certificate", "lease", "fire_certificate", "insurance", "staff_list", "biosecurity"
  documentUrl     String    @map("document_url")
  expiryDate      DateTime? @map("expiry_date")
  status          String    @default("pending") // pending, approved, rejected, expired
  rejectionReason String?   @map("rejection_reason")
  verifiedBy      String?   @map("verified_by")
  verifiedAt      DateTime? @map("verified_at")
  notes           String?
  uploadedBy      String    @map("uploaded_by")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  clinic          Clinic    @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  verifier        User?     @relation("ClinicDocumentVerifier", fields: [verifiedBy], references: [id])
  uploader        User      @relation("ClinicDocumentUploader", fields: [uploadedBy], references: [id])

  @@index([clinicId])
  @@index([status])
  @@index([expiryDate])
  @@map("clinic_documents")
}

model PharmacyDocument {
  id              String    @id @default(cuid())
  pharmacyId      String    @map("pharmacy_id")
  type            String    // "ruc", "sanitary_permit", "municipal_license", "minsa_certificate", "lease", "fire_certificate", "insurance", "staff_list", "biosecurity"
  documentUrl     String    @map("document_url")
  expiryDate      DateTime? @map("expiry_date")
  status          String    @default("pending") // pending, approved, rejected, expired
  rejectionReason String?   @map("rejection_reason")
  verifiedBy      String?   @map("verified_by")
  verifiedAt      DateTime? @map("verified_at")
  notes           String?
  uploadedBy      String    @map("uploaded_by")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  pharmacy        Pharmacy  @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  verifier        User?     @relation("PharmacyDocumentVerifier", fields: [verifiedBy], references: [id])
  uploader        User      @relation("PharmacyDocumentUploader", fields: [uploadedBy], references: [id])

  @@index([pharmacyId])
  @@index([status])
  @@index([expiryDate])
  @@map("pharmacy_documents")
}

model GlobalSetting {
  key         String   @id
  value       String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("global_settings")
}

model Notification {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  title     String
  body      String
  type      String   // e.g. "document_pending", "invitation_accepted", "new_appointment", etc.
  link      String?
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")

  user      User     @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@map("notifications")
}

model UserSettings {
  id                      String   @id @default(cuid())
  userId                  String   @unique @map("user_id")
  theme                   String   @default("system")
  notificationsEnabled    Boolean  @default(true) @map("notifications_enabled")
  notificationPreferences Json     @default("{}") @map("notification_preferences")
  createdAt               DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @updatedAt @map("updated_at")

  user                    User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}

model ClinicSettings {
  id                   String   @id @default(cuid())
  clinicId             String   @unique @map("clinic_id")
  baseConsultationFee  Float    @default(0.0) @map("base_consultation_fee")
  taxRate              Float    @default(0.15) @map("tax_rate")
  defaultPermissions   String[] @default(["view_health_data", "buy_medicines", "schedule_appointments"]) @map("default_permissions")
  notificationPrefs    Json     @default("{}") @map("notification_prefs")
  insurancePartners    String[] @default([]) @map("insurance_partners")
  hoursOfOperation     Json     @default("{}") @map("hours_of_operation")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  clinic               Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@map("clinic_settings")
}

model PharmacySettings {
  id                        String   @id @default(cuid())
  pharmacyId                String   @unique @map("pharmacy_id")
  defaultVatRate            Float    @default(0.15) @map("default_vat_rate")
  ticketFooter              String?  @default("¡Gracias por su compra!") @map("ticket_footer")
  invoiceSeries             String   @default("A") @map("invoice_series")
  minStockAlertThreshold    Int      @default(10) @map("min_stock_alert_threshold")
  expirationAlertDays       Int      @default(90) @map("expiration_alert_days")
  deliveryFeePerKm          Float    @default(15.0) @map("delivery_fee_per_km")
  deliveryCoverageRadiusKm  Float    @default(10.0) @map("delivery_coverage_radius_km")
  defaultCashierRole        String   @default("cashier") @map("default_cashier_role")
  defaultDriverRole         String   @default("delivery_driver") @map("default_driver_role")
  notificationPrefs         Json     @default("{}") @map("notification_prefs")
  createdAt                 DateTime @default(now()) @map("created_at")
  updatedAt                 DateTime @updatedAt @map("updated_at")

  pharmacy                  Pharmacy @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)

  @@map("pharmacy_settings")
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  tokenHash String   @map("token_hash")
  expiresAt DateTime @map("expires_at")
  isUsed    Boolean  @default(false) @map("is_used")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([email])
  @@index([tokenHash])
  @@map("password_reset_tokens")
}




